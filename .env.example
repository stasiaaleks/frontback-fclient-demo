# Server configuration
PORT=3003
NODE_ENV=development

# MongoDB configuration (used by docker compose and the app)
MONGO_USER=admin
MONGO_PASSWORD=password
MONGODB_URI=mongodb://admin:password@localhost:27019/fatclient_db?authSource=admin

# Sessions: use a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
SESSION_TTL_HOURS=8

# How long an edit lock stays valid without being renewed
LOCK_TTL_MINUTES=5

# Accounts created by `make seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
EDITOR_USERNAME=editor
EDITOR_PASSWORD=editor123
